#!/usr/bin/env bash
# ============================================================
# scripts/vhdl-analizar
# Analiza (compila) los fuentes VHDL de una unidad.
#
# Uso:
#   scripts/vhdl-analizar <unidad>
#   ej: scripts/vhdl-analizar datapath-1
#
# <unidad> es una de: datapath-1 | datapath-2 | datapath-3 | mapeo-memoria
#                     | fpga-de10
# Analiza vhdl/<unidad>/src/*.vhd con GHDL en modo VHDL-2008.
#
# Orden de análisis (importa para las dependencias):
#   1. vhdl/fpga-de10/src   módulos comunes de la placa (divisor, hex7seg...)
#   2. vhdl/<unidad>/fpga   envoltorios de placa (top_placa), si existen
#   3. vhdl/<unidad>/src    el diseño
#   4. vhdl/<unidad>/tb     los testbenches
# ============================================================
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -lt 1 ]]; then
    echo "Uso: vhdl-analizar <unidad>"
    echo "  unidades: datapath-1 datapath-2 datapath-3 mapeo-memoria fpga-de10"
    exit 1
fi

UNIDAD="$1"
DIR="$RAIZ/vhdl/$UNIDAD"

if [[ ! -d "$DIR" ]]; then
    echo "Error: no existe la unidad '$UNIDAD' (esperado: vhdl/$UNIDAD)"
    exit 1
fi

if ! command -v ghdl >/dev/null 2>&1; then
    echo "Error: ghdl no está instalado. Ejecuta: bash scripts/instalar.sh"
    exit 1
fi

# Recoger fuentes: src/ primero (dependencias), luego tb/.
# Los paquetes (*_pkg.vhd) van antes que el resto: GHDL necesita
# analizar un package antes de la entidad que lo usa (VHDL-2008).
mapfile -t FUENTES < <(find "$DIR/src" \( -name '*.vhd' -o -name '*.vhdl' \) 2>/dev/null \
    | awk '{ print ($0 ~ /_pkg\.vhd$/) ? "0" $0 : "1" $0 }' | sort | sed 's/^[01]//')
mapfile -t TESTBENCHES < <(find "$DIR/tb" \( -name '*.vhd' -o -name '*.vhdl' \) 2>/dev/null | sort)

# Módulos comunes de la placa DE10-Standard: se analizan antes que el diseño
# para que `divisor`, `hex7seg`... existan en la biblioteca de trabajo.
COMPARTIDAS=()
if [[ "$UNIDAD" != "fpga-de10" && -d "$RAIZ/vhdl/fpga-de10/src" ]]; then
    mapfile -t COMPARTIDAS < <(find "$RAIZ/vhdl/fpga-de10/src" \( -name '*.vhd' -o -name '*.vhdl' \) 2>/dev/null | sort)
fi

# Envoltorios de placa de la unidad (no forman parte de src/ para no romper
# el flujo de simulación del diseño original).
mapfile -t ENVOLTORIOS < <(find "$DIR/fpga" -maxdepth 1 \( -name '*.vhd' -o -name '*.vhdl' \) 2>/dev/null | sort)

if [[ ${#COMPARTIDAS[@]} -eq 0 && ${#ENVOLTORIOS[@]} -eq 0 && ${#FUENTES[@]} -eq 0 && ${#TESTBENCHES[@]} -eq 0 ]]; then
    echo "Error: no hay ficheros .vhd en $DIR/src ni $DIR/tb"
    exit 1
fi

# Directorio de trabajo GHDL (fuera del repo para no ensuciar)
WORK="$DIR/.ghdl"
mkdir -p "$WORK"

echo "=== Analizando unidad: $UNIDAD (VHDL-2008) ==="
cd "$WORK"

for f in "${COMPARTIDAS[@]}" "${ENVOLTORIOS[@]}" "${FUENTES[@]}" "${TESTBENCHES[@]}"; do
    [[ -z "$f" ]] && continue
    echo "  - ${f#"$RAIZ"/}"
    ghdl -a --std=08 --workdir="$WORK" "$f"
done

echo ""
echo "Análisis correcto: ${#FUENTES[@]} fuente(s), ${#TESTBENCHES[@]} testbench(es)."
